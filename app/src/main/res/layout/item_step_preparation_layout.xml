<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <View
        android:id="@+id/timelineLine"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/accent_dark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/stepNumberContainer"
        app:layout_constraintStart_toStartOf="@id/stepNumberContainer"
        app:layout_constraintTop_toBottomOf="@id/stepNumberContainer" />

    <FrameLayout
        android:id="@+id/stepNumberContainer"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_circle_solid_green"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvStepNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvInstructionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:lineSpacingExtra="4dp"
        android:text="Rinse the quinoa under cold water. In a small pot, combine quinoa with 1 cup of water and a pinch of salt."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:justificationMode="inter_word"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/stepNumberContainer"
        app:layout_constraintTop_toTopOf="@id/stepNumberContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
